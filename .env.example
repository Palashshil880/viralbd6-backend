# Copy this file to .env and fill in your own values.
PORT=10000
NODE_ENV=production

# Telegram BotFather token (keep private; never commit the real token)
BOT_TOKEN=

# A long random string used to verify Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS URL of your deployed Render service, e.g. https://your-service.onrender.com
PUBLIC_URL=

# HTTPS URL of your Telegram Mini App
MINI_APP_URL=

# Optional comma-separated allowed frontend origins. Leave blank to allow any origin during initial setup.
CORS_ORIGIN=
